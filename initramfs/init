#!/bin/busybox sh
# SPDX-License-Identifier: MIT
echo 'GTS9WIFI: initramfs init entered' > /dev/kmsg 2>/dev/null || true
export PATH=/bin:/sbin
busybox --install -s /bin

klog()
{
 echo "GTS9WIFI: $*" > /dev/kmsg 2>/dev/null || true
}

mount_checked()
{
 label="$1"
 fstype="$2"
 source="$3"
 target="$4"
 errfile="/run/mount-$label.err"
 : > "$errfile"
 if /bin/busybox mount -t "$fstype" "$source" "$target" >"$errfile" 2>&1; then
  klog "mount $label success target=$target"
  return 0
 fi
 rc=$?
 err="$(/bin/busybox tr '\n' ' ' < "$errfile" 2>/dev/null)"
 klog "mount $label failed rc=$rc target=$target error=$err"
 return "$rc"
}

klog 'initramfs busybox links ready'
mkdir -p /dev/pts /proc /sys /run /tmp /config

devtmpfs_ok=0
proc_ok=0
sysfs_ok=0
devpts_ok=0
run_ok=0
tmp_ok=0

mount_checked devtmpfs devtmpfs devtmpfs /dev && devtmpfs_ok=1
mount_checked proc proc proc /proc && proc_ok=1
mount_checked sysfs sysfs sysfs /sys && sysfs_ok=1
mount_checked devpts devpts devpts /dev/pts && devpts_ok=1
mount_checked run_tmpfs tmpfs tmpfs /run && run_ok=1
mount_checked tmp_tmpfs tmpfs tmpfs /tmp && tmp_ok=1

if [ "$devtmpfs_ok" -eq 1 ] && [ "$proc_ok" -eq 1 ] &&
   [ "$sysfs_ok" -eq 1 ] && [ "$devpts_ok" -eq 1 ] &&
   [ "$run_ok" -eq 1 ] && [ "$tmp_ok" -eq 1 ]; then
 klog 'initramfs pseudo filesystems ready'
else
 klog "initramfs pseudo filesystems incomplete devtmpfs=$devtmpfs_ok proc=$proc_ok sysfs=$sysfs_ok devpts=$devpts_ok run=$run_ok tmp=$tmp_ok"
fi

if [ "$proc_ok" -eq 1 ]; then
 for fs in proc sysfs configfs devtmpfs tmpfs debugfs; do
  if /bin/busybox grep -qw "$fs" /proc/filesystems 2>/dev/null; then
   klog "filesystem available name=$fs"
  else
   klog "filesystem missing name=$fs"
  fi
 done
 for target in /proc /sys /dev /run /tmp; do
  line="$(/bin/busybox grep " $target " /proc/mounts 2>/dev/null | /bin/busybox head -n 1)"
  if [ -n "$line" ]; then
   klog "mount table target=$target entry=$line"
  else
   klog "mount table target=$target entry=<none>"
  fi
 done
fi

echo 'Galaxy Tab S9 mainline diagnostic initramfs (experimental)' > /dev/kmsg

configfs_ok=0
CONFIGFS_ROOT='/sys/kernel/config'

if [ "$sysfs_ok" -eq 1 ]; then
 if [ -d /sys/kernel/config ]; then
  klog 'configfs mountpoint present path=/sys/kernel/config'
 else
  : > /run/configfs-mkdir.err
  if mkdir -p /sys/kernel/config > /run/configfs-mkdir.err 2>&1; then
   klog 'configfs mountpoint created by userspace path=/sys/kernel/config'
  else
   rc=$?
   err="$(/bin/busybox tr '\n' ' ' < /run/configfs-mkdir.err 2>/dev/null)"
   klog "configfs mountpoint missing rc=$rc error=$err"
  fi
 fi
else
 klog 'configfs primary path skipped because sysfs mount failed'
fi

if [ "$sysfs_ok" -eq 1 ] &&
   /bin/busybox grep -q ' /sys/kernel/config configfs ' /proc/mounts 2>/dev/null; then
 configfs_ok=1
 klog 'configfs already mounted path=/sys/kernel/config'
elif [ "$sysfs_ok" -eq 1 ]; then
 : > /run/configfs-mount.err
 if /bin/busybox mount -t configfs none /sys/kernel/config > /run/configfs-mount.err 2>&1; then
  configfs_ok=1
  klog 'configfs mounted path=/sys/kernel/config'
 else
  rc=$?
  err="$(/bin/busybox tr '\n' ' ' < /run/configfs-mount.err 2>/dev/null)"
  klog "configfs primary mount failed rc=$rc error=$err"
 fi
fi

if [ "$configfs_ok" -ne 1 ]; then
 : > /run/configfs-fallback.err
 if /bin/busybox mount -t configfs none /config > /run/configfs-fallback.err 2>&1; then
  configfs_ok=1
  CONFIGFS_ROOT='/config'
  klog 'configfs fallback mounted path=/config'
 else
  rc=$?
  err="$(/bin/busybox tr '\n' ' ' < /run/configfs-fallback.err 2>/dev/null)"
  klog "configfs fallback mount failed rc=$rc error=$err"
 fi
fi

if [ "$configfs_ok" -eq 1 ] && [ "$proc_ok" -eq 1 ]; then
 line="$(/bin/busybox grep " $CONFIGFS_ROOT " /proc/mounts 2>/dev/null | /bin/busybox head -n 1)"
 [ -n "$line" ] || line='<none>'
 klog "configfs mount table root=$CONFIGFS_ROOT entry=$line"
fi

G="$CONFIGFS_ROOT/usb_gadget/gts9wifi"
gadget_ok=0
udc=''

if [ "$configfs_ok" -eq 1 ]; then
 : > /run/gadget-setup.err
 if (
  mkdir -p "$G" &&
  echo 0x1d6b > "$G/idVendor" &&
  echo 0x0104 > "$G/idProduct" &&
  mkdir -p "$G/strings/0x409" &&
  echo 'S9-bringup' > "$G/strings/0x409/serialnumber" &&
  echo 'Mainline bring-up' > "$G/strings/0x409/manufacturer" &&
  echo 'SM-X710 USB diagnostic network' > "$G/strings/0x409/product" &&
  mkdir -p "$G/configs/c.1/strings/0x409" "$G/functions/ncm.usb0" &&
  echo 'USB NCM' > "$G/configs/c.1/strings/0x409/configuration" &&
  echo 250 > "$G/configs/c.1/MaxPower" &&
  echo '02:71:00:00:00:01' > "$G/functions/ncm.usb0/dev_addr" &&
  echo '02:71:00:00:00:02' > "$G/functions/ncm.usb0/host_addr" &&
  ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/ncm.usb0"
 ) 2>/run/gadget-setup.err; then
  gadget_ok=1
  echo 'GTS9WIFI: USB gadget configured' > /dev/kmsg 2>/dev/null || true
 else
  err="$(cat /run/gadget-setup.err 2>/dev/null)"
  echo "GTS9WIFI: USB gadget setup failed error=$err" > /dev/kmsg 2>/dev/null || true
 fi
else
 echo 'GTS9WIFI: USB gadget skipped because configfs unavailable' > /dev/kmsg 2>/dev/null || true
fi

# Probe deferral may leave the controller unavailable briefly. Record the
# distinction between no UDC, bind failure, local usb0 setup and host enum.
if [ "$gadget_ok" -eq 1 ]; then
 last_candidate=''
 i=0
 while [ "$i" -lt 30 ]; do
  seen=0
  for controller in /sys/class/udc/*; do
   [ -e "$controller" ] || continue
   seen=1
   name="${controller##*/}"
   if [ "$name" != "$last_candidate" ]; then
    echo "GTS9WIFI: UDC candidate controller=$name" > /dev/kmsg 2>/dev/null || true
    last_candidate="$name"
   fi
   : > /run/udc-bind.err
   if echo "$name" > "$G/UDC" 2>/run/udc-bind.err; then
    bound="$(cat "$G/UDC" 2>/dev/null)"
    if [ "$bound" = "$name" ]; then
     udc="$name"
     echo "GTS9WIFI: UDC bind success controller=$udc attempt=$i" > /dev/kmsg 2>/dev/null || true
     break
    fi
    echo "GTS9WIFI: UDC bind verification failed controller=$name bound=$bound" > /dev/kmsg 2>/dev/null || true
   else
    err="$(cat /run/udc-bind.err 2>/dev/null)"
    echo "GTS9WIFI: UDC bind failed controller=$name error=$err" > /dev/kmsg 2>/dev/null || true
   fi
  done
  [ -n "$udc" ] && break
  if [ "$seen" -eq 0 ] && [ "$i" -eq 0 ]; then
   echo 'GTS9WIFI: UDC no controller yet' > /dev/kmsg 2>/dev/null || true
  fi
  i=$((i + 1))
  /bin/busybox sleep 1
 done
fi

if [ "$gadget_ok" -ne 1 ]; then
 echo 'GTS9WIFI: USB UDC test skipped because gadget setup failed' > /dev/kmsg 2>/dev/null || true
 dmesg > /run/boot-dmesg.txt
elif [ -z "$udc" ]; then
 echo 'GTS9WIFI: UDC bind timeout' > /dev/kmsg 2>/dev/null || true
 if [ -d /sys/class/udc ]; then
  udc_list="$(ls -1 /sys/class/udc 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
  [ -n "$udc_list" ] || udc_list='<empty>'
  echo "GTS9WIFI: UDC class entries=$udc_list" > /dev/kmsg 2>/dev/null || true
 else
  echo 'GTS9WIFI: UDC class missing' > /dev/kmsg 2>/dev/null || true
 fi

 mkdir -p /sys/kernel/debug
 if mount -t debugfs debugfs /sys/kernel/debug 2>/run/debugfs-mount.err; then
  echo 'GTS9WIFI: debugfs mounted for deferred-probe diagnostics' > /dev/kmsg 2>/dev/null || true
 elif grep -q ' /sys/kernel/debug debugfs ' /proc/mounts 2>/dev/null; then
  echo 'GTS9WIFI: debugfs already mounted' > /dev/kmsg 2>/dev/null || true
 fi
 if [ -r /sys/kernel/debug/devices_deferred ]; then
  while IFS= read -r deferred; do
   [ -n "$deferred" ] || continue
   echo "GTS9WIFI: deferred_probe $deferred" > /dev/kmsg 2>/dev/null || true
  done < /sys/kernel/debug/devices_deferred
 fi

 for driver_dir in /sys/bus/platform/drivers/dwc3 /sys/bus/platform/drivers/dwc3-qcom /sys/bus/platform/drivers/qcom-dwc3; do
  [ -d "$driver_dir" ] || continue
  driver_name="${driver_dir##*/}"
  bound=''
  for node in "$driver_dir"/*; do
   [ -L "$node" ] || continue
   item="${node##*/}"
   case "$item" in
    bind|unbind|module|uevent) continue ;;
   esac
   bound="$bound$item,"
  done
  [ -n "$bound" ] || bound='<none>'
  echo "GTS9WIFI: platform_driver $driver_name bound=$bound" > /dev/kmsg 2>/dev/null || true
 done

 dmesg > /run/boot-dmesg.txt
else
 if [ -d /sys/class/net/usb0 ]; then
  echo 'GTS9WIFI: usb0 present' > /dev/kmsg 2>/dev/null || true
 else
  echo 'GTS9WIFI: usb0 missing after UDC bind' > /dev/kmsg 2>/dev/null || true
 fi

 usb_local_ready=0
 if ifconfig usb0 172.16.71.1 netmask 255.255.255.0 up; then
  usb_local_ready=1
  echo 'GTS9WIFI: usb0 configured address=172.16.71.1' > /dev/kmsg 2>/dev/null || true
  echo "GTS9WIFI: USB NCM local ready controller=$udc" > /dev/kmsg 2>/dev/null || true
  # Diagnostic shell reachable only over the directly attached USB link.
  # No authentication: use this RAM-only image for development, not deployment.
  if telnetd -b 172.16.71.1 -p 23 -l /bin/sh; then
   echo 'GTS9WIFI: telnetd started port=23' > /dev/kmsg 2>/dev/null || true
  else
   echo 'GTS9WIFI: telnetd start failed' > /dev/kmsg 2>/dev/null || true
  fi
 else
  echo 'GTS9WIFI: usb0 configuration failed' > /dev/kmsg 2>/dev/null || true
 fi

 state_file="/sys/class/udc/$udc/state"
 last_state=''
 host_configured=0
 j=0
 while [ "$j" -lt 45 ]; do
  state="$(cat "$state_file" 2>/dev/null)"
  [ -n "$state" ] || state='unavailable'
  if [ "$state" != "$last_state" ]; then
   echo "GTS9WIFI: UDC state controller=$udc state=$state" > /dev/kmsg 2>/dev/null || true
   last_state="$state"
  fi
  if [ "$state" = 'configured' ]; then
   host_configured=1
   echo "GTS9WIFI: USB host configured controller=$udc" > /dev/kmsg 2>/dev/null || true
   break
  fi
  j=$((j + 1))
  /bin/busybox sleep 1
 done

 if [ "$host_configured" -eq 1 ]; then
  echo 'initramfs ready; USB NCM host configured; address 172.16.71.1, telnet port 23' > /dev/kmsg
 else
  echo "GTS9WIFI: USB host configuration timeout controller=$udc final_state=$last_state" > /dev/kmsg 2>/dev/null || true
 fi
 dmesg > /run/boot-dmesg.txt
fi
# Never mount internal UFS or modify Android partitions. Stay in RAM.
while :; do
 setsid sh -c 'exec sh </dev/console >/dev/console 2>&1'
 /bin/busybox sleep 5
done
