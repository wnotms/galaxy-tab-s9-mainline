Subject: [PATCH] arm64: record SM-X710 early boot and virtual-switch markers

Consolidate the SM-X710 pre-MMU, MMU-on, map-kernel and primary virtual-switch
diagnostics into one patch so overlapping head.S edits are applied atomically.
This avoids order-sensitive dependent hunks while preserving the exact marker
semantics used by the bring-up harness.

The post-switch G9E1314..G9E1317 helper is deliberately emitted after __INIT
so it is callable through the normal kernel virtual mapping.  The earlier
identity-map helper remains available for the pre-switch path.

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -84,7 +84,19 @@
 	 */
 SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	cbnz	x19, .Lgts9wifi_skip_entry_01
+	mov_q	x12, 0x0a31303331453947	// "G9E1301\\n"
+	bl	gts9wifi_entry_marker_reset
+.Lgts9wifi_skip_entry_01:
+#endif
 	bl	preserve_boot_args
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	cbnz	x19, .Lgts9wifi_skip_entry_02
+	mov_q	x12, 0x0a32303331453947	// "G9E1302\\n"
+	bl	gts9wifi_entry_marker_append
+.Lgts9wifi_skip_entry_02:
+#endif
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -92,6 +104,12 @@
 	adrp	x0, __pi_init_idmap_pg_dir
 	mov	x1, xzr
 	bl	__pi_create_init_idmap
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	cbnz	x19, .Lgts9wifi_skip_entry_03
+	mov_q	x12, 0x0a33303331453947	// "G9E1303\\n"
+	bl	gts9wifi_entry_marker_append
+.Lgts9wifi_skip_entry_03:
+#endif
 
 	/*
 	 * If the page tables have been populated with non-cacheable
@@ -119,6 +137,12 @@
 1:	mov	x0, x19
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	cbnz	x19, .Lgts9wifi_skip_entry_04
+	mov_q	x12, 0x0a34303331453947	// "G9E1304\\n"
+	bl	gts9wifi_entry_marker_append
+.Lgts9wifi_skip_entry_04:
+#endif
 
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
@@ -127,10 +151,125 @@
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	cbnz	x19, .Lgts9wifi_skip_entry_05
+	mov_q	x12, 0x0a35303331453947	// "G9E1305\\n"
+	bl	gts9wifi_entry_marker_append
+.Lgts9wifi_skip_entry_05:
+#endif
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+/*
+ * sec_log_buf layout used by the downstream recovery and the matching
+ * mainline diagnostic driver:
+ *   +0 boot_count, +4 magic, +8 index, +12 previous_index, +16 data.
+ *
+ * x12 carries one eight-byte ASCII marker. These helpers intentionally use
+ * only caller-saved x9-x11 and do not touch x0/x19/x20/x21 boot state.
+ */
+SYM_CODE_START_LOCAL(gts9wifi_entry_marker_reset)
+	mov_q	x9, 0x0000000880200000
+	ldr	w10, [x9, #4]
+	movz	w11, #0x4f4c
+	movk	w11, #0x4d47, lsl #16	// 0x4d474f4c: "LOGM"
+	cmp	w10, w11
+	b.eq	1f
+	str	w11, [x9, #4]
+	mov	w10, #1
+	str	w10, [x9]
+	b	2f
+1:	ldr	w10, [x9]
+	add	w10, w10, #1
+	str	w10, [x9]
+2:	str	wzr, [x9, #8]
+	str	wzr, [x9, #12]
+	str	x12, [x9, #16]
+	mov	w10, #8
+	str	w10, [x9, #8]
+	str	w10, [x9, #12]
+	dsb	sy
+	ret
+SYM_CODE_END(gts9wifi_entry_marker_reset)
+
+SYM_CODE_START_LOCAL(gts9wifi_entry_marker_append)
+	mov_q	x9, 0x0000000880200000
+	ldr	w10, [x9, #8]
+	/* Keep the assembly diagnostic in the first 256 bytes of ring data. */
+	cmp	w10, #248
+	b.hi	1f
+	add	x11, x9, #16
+	add	x11, x11, w10, uxtw
+	str	x12, [x11]
+	add	w10, w10, #8
+	str	w10, [x9, #8]
+	str	w10, [x9, #12]
+	dsb	sy
+1:	ret
+SYM_CODE_END(gts9wifi_entry_marker_append)
+
+/*
+ * MMU-on variant.  The sec-log PA is identity-mapped by early_map_kernel();
+ * clean both the data slot and header so recovery sees the marker after reset.
+ */
+SYM_CODE_START_LOCAL(gts9wifi_entry_marker_append_mmu_on)
+	mov_q	x9, 0x0000000880200000
+	ldr	w10, [x9, #8]
+	cmp	w10, #248
+	b.hi	1f
+	add	x11, x9, #16
+	add	x11, x11, w10, uxtw
+	str	x12, [x11]
+	add	w10, w10, #8
+	str	w10, [x9, #8]
+	str	w10, [x9, #12]
+	dc	cvac, x11
+	dc	cvac, x9
+	dsb	sy
+1:	ret
+SYM_CODE_END(gts9wifi_entry_marker_append_mmu_on)
+
+	.macro	gts9wifi_entry_marker_inline value
+	mov_q	x12, \value
+	mov_q	x9, 0x0000000880200000
+	ldr	w10, [x9, #8]
+	add	x11, x9, #16
+	add	x11, x11, w10, uxtw
+	str	x12, [x11]
+	add	w10, w10, #8
+	str	w10, [x9, #8]
+	str	w10, [x9, #12]
+	dc	cvac, x11
+	dc	cvac, x9
+	dsb	sy
+	.endm
+#endif
+
 	__INIT
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+/*
+ * Post-switch marker helper. This lives after __INIT, so it is part of
+ * the normal kernel init mapping rather than .idmap.text.
+ */
+SYM_CODE_START_LOCAL(gts9wifi_entry_marker_append_kernel_va)
+	mov_q	x9, 0x0000000880200000
+	ldr	w10, [x9, #8]
+	cmp	w10, #248
+	b.hi	1f
+	add	x11, x9, #16
+	add	x11, x11, w10, uxtw
+	str	x12, [x11]
+	add	w10, w10, #8
+	str	w10, [x9, #8]
+	str	w10, [x9, #12]
+	dc	cvac, x11
+	dc	cvac, x9
+	dsb	sy
+1:	ret
+SYM_CODE_END(gts9wifi_entry_marker_append_kernel_va)
+#endif
+
 SYM_CODE_START_LOCAL(record_mmu_state)
 	mrs	x19, CurrentEL
 	cmp	x19, #CurrentEL_EL2
@@ -218,6 +357,13 @@
  *   x0 = __pa(KERNEL_START)
  */
 SYM_FUNC_START_LOCAL(__primary_switched)
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_entry_marker_inline 0x0a33303030563947	// "G9V0003\n"
+#endif
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a34313331453947	// "G9E1314\n"
+	bl	gts9wifi_entry_marker_append_kernel_va
+#endif
 	adr_l	x4, init_task
 	init_cpu_task x4, x5, x6
 
@@ -240,9 +386,21 @@
 #if defined(CONFIG_KASAN_GENERIC) || defined(CONFIG_KASAN_SW_TAGS)
 	bl	kasan_early_init
 #endif
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a35313331453947	// "G9E1315\n"
+	bl	gts9wifi_entry_marker_append_kernel_va
+#endif
 	mov	x0, x20
 	bl	finalise_el2			// Prefer VHE if possible
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a36313331453947	// "G9E1316\n"
+	bl	gts9wifi_entry_marker_append_kernel_va
+#endif
 	ldp	x29, x30, [sp], #16
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a37313331453947	// "G9E1317\n"
+	bl	gts9wifi_entry_marker_append_kernel_va
+#endif
 	bl	start_kernel
 	ASM_BUG()
 SYM_FUNC_END(__primary_switched)
@@ -508,6 +666,10 @@
 SYM_FUNC_START_LOCAL(__primary_switch)
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a36303331453947	// "G9E1306\n"
+	bl	gts9wifi_entry_marker_append
+#endif
 	bl	__enable_mmu
 
 	adrp	x1, early_init_stack
@@ -516,8 +678,19 @@
 	mov	x0, x20				// pass the full boot status
 	mov	x1, x21				// pass the FDT
 	bl	__pi_early_map_kernel		// Map and relocate the kernel
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a33313331453947	// "G9E1313\n"
+	bl	gts9wifi_entry_marker_append_mmu_on
+#endif
 
 	ldr	x8, =__primary_switched
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	mov_q	x12, 0x0a31303030563947	// "G9V0001\n"
+	bl	gts9wifi_entry_marker_append_mmu_on
+	ldr	w9, [x8]			// prove the high-VA target is readable
+	mov_q	x12, 0x0a32303030563947	// "G9V0002\n"
+	bl	gts9wifi_entry_marker_append_mmu_on
+#endif
 	adrp	x0, KERNEL_START		// __pa(KERNEL_START)
 	br	x8
 SYM_FUNC_END(__primary_switch)

diff --git a/arch/arm64/kernel/pi/map_kernel.c b/arch/arm64/kernel/pi/map_kernel.c
--- a/arch/arm64/kernel/pi/map_kernel.c
+++ b/arch/arm64/kernel/pi/map_kernel.c
@@ -215,6 +215,50 @@
 	return (void *)fdt;
 }
 
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+#define GTS9WIFI_SEC_LOG_BASE	0x880200000ULL
+#define GTS9WIFI_SEC_LOG_SIZE	SZ_2M
+
+static void __init gts9wifi_map_sec_log(void)
+{
+	static u8 ptes[INIT_IDMAP_FDT_SIZE] __initdata __aligned(PAGE_SIZE);
+	phys_addr_t ptep = (phys_addr_t)ptes;
+
+	/*
+	 * Keep Samsung's persistent 2 MiB log identity-mapped while TTBR0 still
+	 * points at the initial idmap.  This lets the MMU-on bring-up path leave
+	 * checkpoints before the normal early_ioremap/console infrastructure.
+	 */
+	map_range(&ptep, GTS9WIFI_SEC_LOG_BASE,
+		  GTS9WIFI_SEC_LOG_BASE + GTS9WIFI_SEC_LOG_SIZE,
+		  GTS9WIFI_SEC_LOG_BASE, PAGE_KERNEL, IDMAP_ROOT_LEVEL,
+		  (pte_t *)init_idmap_pg_dir, false, 0);
+	dsb(ishst);
+	isb();
+}
+
+static void __init gts9wifi_sec_log_pi_marker(u64 marker)
+{
+	volatile u32 *index = (volatile u32 *)(GTS9WIFI_SEC_LOG_BASE + 8);
+	volatile u32 *previous = (volatile u32 *)(GTS9WIFI_SEC_LOG_BASE + 12);
+	volatile u64 *slot;
+	u32 offset = *index;
+
+	if (offset > 248)
+		return;
+
+	slot = (volatile u64 *)(GTS9WIFI_SEC_LOG_BASE + 16 + offset);
+	*slot = marker;
+	*index = offset + sizeof(marker);
+	*previous = offset + sizeof(marker);
+
+	/* Recovery reads this after a reset, so push both data and header to PoC. */
+	asm volatile("dc cvac, %0" :: "r"(slot) : "memory");
+	asm volatile("dc cvac, %0" :: "r"((void *)GTS9WIFI_SEC_LOG_BASE) : "memory");
+	asm volatile("dsb sy" ::: "memory");
+}
+#endif
+
 /*
  * PI version of the Cavium Eratum 27456 detection, which makes it
  * impossible to use non-global mappings.
@@ -246,14 +290,30 @@
 	int root_level = 4 - CONFIG_PGTABLE_LEVELS;
 	int va_bits = VA_BITS;
 	int chosen;
+	void *fdt_mapped;
+
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_map_sec_log();
+	gts9wifi_sec_log_pi_marker(0x0a37303331453947); /* G9E1307 */
+#endif
+
+	fdt_mapped = map_fdt(fdt);
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_sec_log_pi_marker(0x0a38303331453947); /* G9E1308 */
+#endif
-	void *fdt_mapped = map_fdt(fdt);
 
 	/* Clear BSS and the initial page tables */
 	memset(__bss_start, 0, (char *)init_pg_end - (char *)__bss_start);
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_sec_log_pi_marker(0x0a39303331453947); /* G9E1309 */
+#endif
 
 	/* Parse the command line for CPU feature overrides */
 	chosen = fdt_path_offset(fdt_mapped, chosen_str);
 	init_feature_override(boot_status, fdt_mapped, chosen);
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_sec_log_pi_marker(0x0a30313331453947); /* G9E1310 */
+#endif
 
 	if (IS_ENABLED(CONFIG_ARM64_64K_PAGES) && !cpu_has_lva()) {
 		va_bits = VA_BITS_MIN;
@@ -285,5 +345,11 @@
 		remap_idmap_for_lpa2();
 
 	va_base = KIMAGE_VADDR + kaslr_offset;
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_sec_log_pi_marker(0x0a31313331453947); /* G9E1311 */
+#endif
 	map_kernel(kaslr_offset, va_base - pa_base, root_level);
+#ifdef CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG
+	gts9wifi_sec_log_pi_marker(0x0a32313331453947); /* G9E1312 */
+#endif
 }
