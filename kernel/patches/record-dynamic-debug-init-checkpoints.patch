Subject: [PATCH] lib: trace SM-X710 dynamic_debug early initcall

The s9u-va48 control now reaches kernel_init_freeable() and enters the early
initcall sequence, but its persistent log ends after the initcall_debug
"calling dynamic_debug_init" record without the matching return record.

Add low-volume progress markers around the built-in __dyndbg walk, per-module
table insertion, and boot-parameter parse so the next run can distinguish a
descriptor walk fault from allocator/list/mutex or parse_args failure.

diff --git a/lib/dynamic_debug.c b/lib/dynamic_debug.c
--- a/lib/dynamic_debug.c
+++ b/lib/dynamic_debug.c
@@ -1419,6 +1419,9 @@
 		.num_classes = __stop___dyndbg_classes - __start___dyndbg_classes,
 	};
 
+	pr_info("GTS9WIFI: dynamic_debug_init enter descs=%u classes=%u start=%px stop=%px\n",
+		di.num_descs, di.num_classes, __start___dyndbg, __stop___dyndbg);
+
 #ifdef CONFIG_MODULES
 	ret = register_module_notifier(&ddebug_module_nb);
 	if (ret) {
@@ -1440,27 +1443,43 @@
 	iter = iter_mod_start = __start___dyndbg;
 	modname = iter->modname;
 	i = mod_sites = mod_ct = 0;
+	pr_info("GTS9WIFI: dynamic_debug_init walk_begin first_modname=%px\n",
+		modname);
 
 	for (; iter < __stop___dyndbg; iter++, i++, mod_sites++) {
+		if (i < 4 || !(i & 0x3ff))
+			pr_info("GTS9WIFI: dynamic_debug_init walk i=%d iter=%px base_modname=%px current_modname=%px\n",
+				i, iter, modname, iter->modname);
 
 		if (strcmp(modname, iter->modname)) {
 			mod_ct++;
 			di.num_descs = mod_sites;
 			di.descs = iter_mod_start;
+			if (mod_ct < 8 || !(mod_ct & 0x3f))
+				pr_info("GTS9WIFI: dynamic_debug_init add_begin module=%d sites=%d modname=%px\n",
+					mod_ct, mod_sites, modname);
 			ret = ddebug_add_module(&di, modname);
 			if (ret)
 				goto out_err;
+			if (mod_ct < 8 || !(mod_ct & 0x3f))
+				pr_info("GTS9WIFI: dynamic_debug_init add_done module=%d\n",
+					mod_ct);
 
 			mod_sites = 0;
 			modname = iter->modname;
 			iter_mod_start = iter;
 		}
 	}
+	pr_info("GTS9WIFI: dynamic_debug_init walk_done sites=%d modules=%d last_sites=%d\n",
+		i, mod_ct, mod_sites);
 	di.num_descs = mod_sites;
 	di.descs = iter_mod_start;
+	pr_info("GTS9WIFI: dynamic_debug_init final_add_begin sites=%d modname=%px\n",
+		mod_sites, modname);
 	ret = ddebug_add_module(&di, modname);
 	if (ret)
 		goto out_err;
+	pr_info("GTS9WIFI: dynamic_debug_init final_add_done\n");
 
 	ddebug_init_success = 1;
 	vpr_info("%d prdebugs in %d modules, %d KiB in ddebug tables, %d kiB in __dyndbg section\n",
@@ -1478,9 +1497,13 @@
 	 * to activate queries for not-yet-loaded modules, which is
 	 * slightly noisy if verbose, but harmless.
 	 */
+	pr_info("GTS9WIFI: dynamic_debug_init before_cmdline_copy\n");
 	cmdline = kstrdup(saved_command_line, GFP_KERNEL);
+	pr_info("GTS9WIFI: dynamic_debug_init before_parse_args cmdline=%px\n",
+		cmdline);
 	parse_args("dyndbg params", cmdline, NULL,
 		   0, 0, 0, NULL, &ddebug_dyndbg_boot_param_cb);
+	pr_info("GTS9WIFI: dynamic_debug_init after_parse_args\n");
 	kfree(cmdline);
 	return 0;
 
