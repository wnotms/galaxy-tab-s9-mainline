# Diagnostic address-geometry control for SM-X710.
#
# Start from the S9 Ultra reference + X710 bring-up + s9u-nobti override, then
# use the conservative 4 KiB / 48-bit VA / 48-bit PA geometry.  ARM64_LPA2 is
# a derived def_bool and therefore resolves to n when PA_BITS_52 is disabled;
# PGTABLE_LEVELS consequently resolves from 5 to 4.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
